{
  "name": "l8physio-e2e",
  "version": "2.0.0",
  "private": true,
  "description": "Playwright end-to-end tests for l8physio against a KIND cluster",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:desktop": "playwright test --project=desktop",
    "test:mobile": "playwright test --project=mobile",
    "test:api": "playwright test --project=api",
    "test:kind": "playwright test --project=kind",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.4.0"
  }
}
